# VanaDash: copy to .env and fill in. Never commit .env.
#
# To run locally you need only the three values marked REQUIRED. Everything else is an
# integration: left empty, that feature is switched off (it logs why) and the rest still works.

# ── Core ─────────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://vanadash:vanadash@localhost:5433/vanadash
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# CORS origin and the base of links sent by email.
FRONTEND_ORIGIN=http://localhost:5174
# Language (ro or en) and display currency (RON, EUR, USD) a new person and every job start with.
# Each person changes both in My profile. Without these lines: ro and RON.
DEFAULT_LOCALE=en
DEFAULT_DISPLAY_CURRENCY=RON

# The first user, created by `db:seed` as admin.
ADMIN_EMAIL=admin@example.com
# REQUIRED. At least 12 characters.
ADMIN_PASSWORD=

# REQUIRED. openssl rand -base64 48
JWT_SECRET=
# REQUIRED. Encrypts stored API keys and bank credentials (AES-256-GCM). openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# Where invoice XML/PDF files are written. A Docker volume in production.
STORAGE_DIR=./storage

# ── Company profile (printed on issued invoices and contracts) ───────────────

COMPANY_NAME=Example SRL
COMPANY_CIF=
COMPANY_REG_COM=
COMPANY_ADDRESS=
COMPANY_CITY=Bucuresti
# CIUS-RO county code: RO-B, RO-CJ, ...
COMPANY_COUNTY_CODE=RO-B
COMPANY_IBAN=
COMPANY_BANK=
COMPANY_EMAIL=office@example.com
COMPANY_PHONE=
COMPANY_REPRESENTATIVE=
COMPANY_VAT_PAYER=false
# Intra-community VAT code (art. 317). Empty = D301/D390 for EU services stay blocked.
COMPANY_VAT_INTRA_CODE=
# Who signs the D301/D390 declarations.
DECLARANT_FIRST_NAME=
DECLARANT_LAST_NAME=
DECLARANT_ROLE=Administrator

# ── Romania: ANAF e-Factura / SPV ────────────────────────────────────────────

# Stay on `sandbox` until your XML validates. The OAuth app is registered on the ANAF portal
# and needs a qualified digital certificate.
ANAF_ENV=sandbox
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=http://localhost:3001/api/accounting/anaf/callback

# ── Bank: Revolut Business ───────────────────────────────────────────────────

# Sandbox: https://sandbox-b2b.revolut.com/api/1.0. The client id is per bank account and is
# entered in the UI (Reconciliation → Settings), not here.
REVOLUT_API_URL=https://b2b.revolut.com/api/1.0
REVOLUT_REDIRECT_URI=http://localhost:5174/reconciliation/revolut-callback

# ── PDF rendering ────────────────────────────────────────────────────────────

# Path to Chromium for puppeteer-core. Empty = no PDFs (HTML and XML still work).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Email (Resend) ───────────────────────────────────────────────────────────

# Empty = nothing is sent; messages are logged instead.
RESEND_API_KEY=
# Shown as a warning in the Sent tab; Resend enforces the real limit.
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000

ALERT_EMAIL_FROM=VanaDash <alerts@example.com>
ALERT_EMAIL_TO=admin@example.com

# Sending identities offered in Compose. Format: "Display Name <address>"; the domain must be
# verified in Resend. EMAIL_FROM_STEFAN is the personal identity of the account owner.
EMAIL_FROM_STEFAN=Owner <owner@example.com>
EMAIL_FROM_CONTACT=Example <contact@example.com>
EMAIL_FROM_NOREPLY=Example <no-reply@example.com>
# Cold outreach, ideally on its own subdomain. Empty = falls back to EMAIL_FROM_CONTACT.
EMAIL_FROM_OUTREACH=

# Signatures appended in Compose (\n = new line) and an optional public logo URL.
EMAIL_SIGNATURE_STEFAN_TEXT="Owner\nExample"
EMAIL_SIGNATURE_CONTACT_TEXT="Example"
EMAIL_LOGO_URL=

# Unsubscribe footer on bulk sends, and the HMAC key of the unsubscribe link.
# openssl rand -hex 32. Rotating it breaks links already sent.
EMAIL_UNSUBSCRIBE_TEXT=Pentru a nu mai primi acest tip de email, răspunde cu 'dezabonare'.
EMAIL_UNSUBSCRIBE_SECRET=

# Unused since the move to Resend; still read by config.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Inbound webhooks and machine-to-machine tokens ───────────────────────────
#
# Each route below rejects every request while its secret is empty (fail-closed).
# Generate each with: openssl rand -hex 32

# POST /api/webhooks/resend-inbound: Svix signing secret from the Resend dashboard (whsec_...).
RESEND_WEBHOOK_SECRET=
# POST /api/webhooks/cloudflare-inbound: same value as the secret of the Worker in
# infra/cloudflare-email-worker/.
CLOUDFLARE_EMAIL_INGEST_TOKEN=
# POST /api/webhooks/sentry: client secret of the Sentry integration.
SENTRY_WEBHOOK_SECRET=
# POST /api/monitoring/host-metrics: called by infra/host-metrics-collector.sh on the host.
HOST_METRICS_INGEST_TOKEN=
# /api/v1/public/booking/*: called by the public website's booking form.
BOOKING_TOKEN=
BOOKING_CANCEL_URL=https://example.com/booking/cancel
# Optional, one per site language with its own URL: BOOKING_CANCEL_URL_RO=https://example.com/ro/booking/cancel

# Integration with VanaGreen, the author's other product. Irrelevant unless you run it.
VANAGREEN_ALERT_INGEST_TOKEN=
VANAGREEN_PRICING_INGEST_TOKEN=
VANAGREEN_BILLING_INGEST_TOKEN=
# Snapshot push from an external trading bot. Leave empty unless you run one: the Bot tabs under
# Investments and their alerts stay hidden.
JEFFBOT_INGEST_TOKEN=

# ── Backups ──────────────────────────────────────────────────────────────────

# Daily pg_dump (03:00 UTC).
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# ── Archive module: Cloudflare R2 ────────────────────────────────────────────

# Empty = the Archive raises a clear error on first upload; nothing else is affected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Push notifications ───────────────────────────────────────────────────────

# Web push. Generate once: npx web-push generate-vapid-keys. Empty = push is skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Android app (FCM): the Firebase service account JSON on one line. Empty = skipped.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── In-app assistant ─────────────────────────────────────────────────────────

# Empty = the Assistant page says it is not configured.
ANTHROPIC_API_KEY=
ANTHROPIC_ASSISTANT_MODEL=claude-opus-4-8
OPENROUTER_API_KEY=
# Local assistant: an OpenAI-compatible llama-server (ends in /v1). Empty = switched off.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT_MS=1800000
LOCAL_AI_MAX_TOKENS=1500
