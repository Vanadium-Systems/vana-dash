{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vana-dash-cloudflare-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "vars": {
    "VANA_DASH_WEBHOOK_URL": "https://dash.vanadium.systems/api/webhooks/cloudflare-inbound",
    "OWN_DOMAIN": "vanadium.systems"
  },
  // Where a message waits when the app does not answer (keys inbound-pending/…, refused ones
  // inbound-dead/…); the cron below replays it. Create once with
  //   npx wrangler kv namespace create vana-dash-inbound-pending
  // and put the id it prints here.
  "kv_namespaces": [{ "binding": "PENDING", "id": "5af254bbf0a14888bc9a5aa882f15580" }],
  // The "app is not answering" alert. It can only reach verified destination addresses.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] }
  // The two values above belong to one installation; change them to yours.
  // FALLBACK_ADDRESS (the mailbox outside the app that gets a copy when the app is down) is personal:
  //   npx wrangler secret put FALLBACK_ADDRESS
  // CLOUDFLARE_EMAIL_INGEST_TOKEN never goes here, in code or in vars. Set it only with:
  //   npx wrangler secret put CLOUDFLARE_EMAIL_INGEST_TOKEN
  // It has to be identical to the value in the app's production .env (config.ts,
  // cloudflareEmailIngestToken). Two places, easy to let drift apart.
}
