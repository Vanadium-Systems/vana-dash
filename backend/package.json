{
  "name": "@vana-dash/backend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "vana-dash backend (Fastify + Drizzle ORM + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed": "tsx src/shared/db/seed.ts",
    "db:seed:demo": "tsx src/shared/db/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.5",
    "argon2": "^0.41.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^3.0.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.3.0",
    "html-to-text": "^10.0.1",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "postal-mime": "^2.7.6",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.5.0",
    "rrule": "^2.8.1",
    "selfsigned": "^5.5.0",
    "svix": "^1.99.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.12"
  }
}
